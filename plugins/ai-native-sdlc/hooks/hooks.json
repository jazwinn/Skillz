{
  "description": "AI-native SDLC gates — protected paths, frozen tests during a bug fix, and the production deploy authorization. Inert until a repository adds .claude/sdlc.json.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/sdlc-guard.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/sdlc-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
